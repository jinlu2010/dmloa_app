<view><view class="status-contents"><view class="status top-view"><view class="titles"><view class="UserFace"><image src="{{imgUrl}}"></image></view><view class="titleText">{{titleText}}</view><view class="RightButton"><uni-icons vue-id="8fa47622-1" type="plus" size="32" color="white" data-event-opts="{{[['^tap',[['NewTask']]]]}}" bind:tap="__e" bind:__l="__l"></uni-icons></view></view></view></view><view class="place"></view><view class="tabbar project"><view class="bgtab"></view><view class="tab-title"><view data-event-opts="{{[['tap',[['toassign',['$event']]]]]}}" class="{{[(btncontent==0)?'active':'']}}" bindtap="__e">待分配任务</view><view data-event-opts="{{[['tap',[['assigned',['$event']]]]]}}" class="{{[(btncontent==1)?'active':'']}}" bindtap="__e">已分配任务</view><view data-event-opts="{{[['tap',[['delayed',['$event']]]]]}}" class="{{[(btncontent==2)?'active':'']}}" bindtap="__e">延期任务</view></view></view><view class="{{['tab-content',(btncontent==0)?'tab':'']}}"><view class="list"><view class="list-item-container rightlist"><block wx:if="{{tasklist==''}}"><view><text class="none">暂时没有未分配任务哦~</text></view></block><block wx:for="{{tasklist}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="list-item-content"><view class="list-content-left project-left"><text class="title teamkpi">{{item.name}}</text></view><view class="list-content-right project-right"><button data-event-opts="{{[['tap',[['AssignTask',['$0'],[[['tasklist','id',item.id]]]]]]]}}" class="btngreen" bindtap="__e">分配</button><button data-event-opts="{{[['tap',[['DelTask',['$0'],[[['tasklist','id',item.id]]]]]]]}}" class="btnblue" bindtap="__e">删除</button></view></view></block></view></view></view><view class="{{['tab-content',(btncontent==1)?'tab':'']}}"><view class="choicetime"><button class="calendar-button" type="button" value="{{info.date}}" data-event-opts="{{[['tap',[['open',['$event']]]],['input',[['__set_model',['$0','date','$event',[]],['info']]]]]}}" bindtap="__e" bindinput="__e">{{''+info.date+''}}<uni-icons class="pl20" vue-id="8fa47622-2" type="arrowdown" size="12" color="#004343" bind:__l="__l"></uni-icons></button><uni-calendar class="vue-ref" vue-id="8fa47622-3" selected="{{info.selected}}" showMonth="{{false}}" date="{{info.date}}" insert="{{false}}" lunar="{{false}}" range="{{false}}" data-ref="calendar" data-event-opts="{{[['^confirm',[['confirm']]]]}}" bind:confirm="__e" bind:__l="__l"></uni-calendar></view><view class="list-layout"><view class="list assign"><view class="list-item-container"><block wx:if="{{taskdetail==''}}"><view><text class="none">今日没有分配过的任务哦~</text></view></block><block wx:for="{{taskdetail}}" wx:for-item="item" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['Detail',['$0'],[[['taskdetail','id',item.id]]]]]]]}}" class="list-item-content pr60 listheight" bindtap="__e"><view class="list-content-left"><text class="title">{{item.name}}</text><view class="operator">To<text class="pl20">{{item.operator}}</text></view></view><view class="list-content-middle"><text class="note">{{item.operator_finished}}</text><text class="date grey">{{"至"+item.end_at}}</text></view><view class="list-content-right"><block wx:if="{{item.operator_finished=='已完成'||item.operator_finished=='已终止'}}"><view><button data-event-opts="{{[['tap',[['EditTask',['$0'],[[['taskdetail','id',item.id]]]]]]]}}" class="hidden" catchtap="__e">修改</button></view></block><block wx:if="{{item.operator_finished=='进行中'}}"><view><button data-event-opts="{{[['tap',[['EditTask',['$0'],[[['taskdetail','id',item.id]]]]]]]}}" class="btngreen" catchtap="__e">修改</button></view></block></view></view></block></view></view></view></view><view class="{{['tab-content',(btncontent==2)?'tab':'']}}"><view class="list-layout delay"><view class="list assign"><block wx:if="{{delaylist==''}}"><view><text class="none">没有延期任务哦~</text></view></block><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i2__" wx:key="id"><view data-event-opts="{{[['tap',[['Detail',['$0'],[[['delaylist','id',item.$orig.id]]]]]]]}}" class="list-item-content pr60 listheight" bindtap="__e"><view class="list-content-left"><text class="title">{{item.$orig.name}}</text><view class="operator">To<text class="pl20">{{item.$orig.operator}}</text></view></view><view class="list-content-middle"><text class="note">{{"已逾期"+item.m0}}</text><text class="date grey">{{"至"+item.$orig.end_at}}</text></view><view class="list-content-right"><button data-event-opts="{{[['tap',[['EditTask',['$0'],[[['delaylist','id',item.$orig.id]]]]]]]}}" class="btngreen" catchtap="__e">修改</button></view></view></block></view></view></view></view>