<view class="newtask"><form><view class="form"><view class="form-item"><view class="title">任务标题</view><input class="input" placeholder="请输入任务内容" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" value="{{name}}" bindinput="__e"/></view><view class="form-item"><view class="title">任务周期</view><view style="width:280px;"><uni-datetime-picker vue-id="79869162-1" type="daterange" border="{{false}}" clearIcon="{{false}}" value="{{range}}" data-event-opts="{{[['^maskClick',[['maskClick']]],['^input',[['__set_model',['','range','$event',[]]]]]]}}" bind:maskClick="__e" bind:input="__e" bind:__l="__l"></uni-datetime-picker></view></view><view class="form-item"><view class="title">所属项目</view><picker value="{{project_id}}" range="{{projectArr}}" range-key="name" data-event-opts="{{[['change',[['projectArrChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{projectArr[project_id].name+''}}<uni-icons class="pl20" vue-id="79869162-2" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker><picker value="{{module_id}}" range="{{moduleArr}}" range-key="name" data-event-opts="{{[['change',[['moduleArrChange',['$event']]]],['tap',[['moduleList',['$event']]]]]}}" bindchange="__e" bindtap="__e"><view class="input">{{moduleArr[module_id].name+''}}<uni-icons class="pl20" vue-id="79869162-3" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">紧急程度</view><picker value="{{level_id}}" range="{{levelArr}}" range-key="name" data-event-opts="{{[['change',[['levelArrChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{levelArr[level_id].name+''}}<uni-icons class="pl20" vue-id="79869162-4" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">执行人</view><radio-group data-event-opts="{{[['change',[['userTypeChange',['$event']]]]]}}" bindchange="__e"><view class="btnradio"><radio id="自己" value="0" checked="{{user_type==true}}">自己</radio><radio id="他/多人" value="1" checked="{{user_type==false}}">他/多人</radio></view></radio-group></view><view hidden="{{!(show)}}" class="form-item other-radio"><view class="other-radio-item"><text>可执行人</text><checkbox-group data-event-opts="{{[['change',[['executorChange',['$event']]]]]}}" bindchange="__e"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><label><view class="btnotherradio"><checkbox value="{{item.g0}}" checked="{{user_ids[index]==item.$orig.id?true:false}}"></checkbox></view><view class="btnotherradio mr30">{{item.$orig.name}}</view></label></block></checkbox-group></view></view><view class="form-item"><view class="title">特别提醒</view><view class="textarea"><textarea auto-height="{{true}}" placeholder="请输入注意事项" data-event-opts="{{[['blur',[['bindTextAreaBlur',['$event']]]],['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindblur="__e" bindinput="__e"></textarea></view></view></view><button data-event-opts="{{[['tap',[['addTask']]]]}}" class="btngreen btnform" bindtap="__e">保存</button><button data-event-opts="{{[['tap',[['stopTask']]]]}}" class="btnblue border100 mr60 mb20" bindtap="__e">终止</button><button data-event-opts="{{[['tap',[['delTask']]]]}}" class="btngrey border100 mr60" bindtap="__e">删除</button></form></view>