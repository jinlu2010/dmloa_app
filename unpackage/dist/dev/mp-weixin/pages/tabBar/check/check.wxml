ta-event-opts="{{[['^tap',[['taphide']]]]}}" bind:tap="__e" bind:__l="__l"></uni-icons></view></view></form></view></view></view><view class="{{['tab-content',(btncontent==1)?'tab':'']}}"><view class="list"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i1__" wx:key="id"><view class="list-item-container"><view data-event-opts="{{[['tap',[['Detail',['$event']]]]]}}" class="list-item-content pr60 pt20 listheight" bindtap="__e"><view class="list-content-left"><text class="title">{{item.$orig.name}}</text><text class="note">{{item.g0+" From "+item.$orig.operator.name}}</text></view><view class="list-content-right"><text class="h1 lh120">{{"+"+item.$orig.score}}</text></view></view></view></block></view></view></view>