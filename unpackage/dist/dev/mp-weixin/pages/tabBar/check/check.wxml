<view><view class="status-contents"><view class="status top-view"><view class="titles"><view class="UserFace"><image src="{{imgUrl}}"></image></view><view class="titleText">{{titleText}}</view></view></view></view><view class="place"></view><view class="tabbar"><view class="bgtab"></view><view class="tab-title"><view data-event-opts="{{[['tap',[['teamList',['$event']]]]]}}" class="{{[(btncontent==0)?'active':'']}}" bindtap="__e">团队绩效</view><view data-event-opts="{{[['tap',[['myList',['$event']]]]]}}" class="{{[(btncontent==1)?'active':'']}}" bindtap="__e">我的绩效</view></view></view><view class="{{['tab-content',(btncontent==0)?'tab':'']}}"><view class="choicetime"><button class="calendar-button" type="button" data-event-opts="{{[['tap',[['open',['$event']]]]]}}" bindtap="__e">{{info.date}}<uni-icons class="pl20" vue-id="ff934606-1" type="arrowdown" size="12" color="#004343" bind:__l="__l"></uni-icons></button><uni-calendar class="vue-ref" vue-id="ff934606-2" selected="{{info.selected}}" showMonth="{{false}}" date="{{info.date}}" insert="{{false}}" lunar="{{false}}" range="{{false}}" data-ref="calendar" data-event-opts="{{[['^confirm',[['confirm']]]]}}" bind:confirm="__e" bind:__l="__l"></uni-calendar></view><view class="team-layout"><block wx:for="{{teamlist}}" wx:for-item="item" wx:for-index="i" wx:key="i"><view class="team"><view class="team-title">{{"0"+(i+1)+" "+item.user.name+" "+item.user.department+"-"+item.user.job}}</view><block wx:if="{{item.tasks==''}}"><view class="team-item-container"><text class="nonetask">今天没有任务哦~</text></view></block><block wx:for="{{item.tasks}}" wx:for-item="task" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['Detail',['$event']]]]]}}" class="team-item-container" bindtap="__e"><view class="team-item-content"><view class="list-content-left"><text class="title">{{task.name}}</text><text class="note">{{"From "+task.creator.name}}</text></view><view class="list-content-middle"><text class="note">{{task.finished==fa