<view class="newtask"><form data-event-opts="{{[['submit',[['formSubmit',['$event']]]],['reset',[['formReset',['$event']]]]]}}" bindsubmit="__e" bindreset="__e"><view class="form"><view class="form-item"><view class="title">标题</view><input class="input" value="{{name}}" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" bindinput="__e"/></view><view class="form-item"><view class="title">负责人</view><picker value="{{index}}" range="{{userArr}}" range-key="name" data-event-opts="{{[['change',[['userArrChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{userArr[index].name+''}}<uni-icons class="pl20" vue-id="08b04f1a-1" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">项目周期</view><view style="width:280px;"><uni-datetime-picker vue-id="08b04f1a-2" type="daterange" border="{{false}}" clearIcon="{{false}}" value="{{range}}" data-event-opts="{{[['^maskClick',[['maskClick']]],['^input',[['__set_model',['','range','$event',[]]]]]]}}" bind:maskClick="__e" bind:input="__e" bind:__l="__l"></uni-datetime-picker></view></view><view class="form-item"><view class="title">状态</view><picker value="{{status_id}}" range="{{statusArr}}" range-key="name" data-event-opts="{{[['change',[['statusArrChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{statusArr[status_id].name+''}}<uni-icons class="pl20" vue-id="08b04f1a-3" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view></view><view class="project-button"><button data-event-opts="{{[['tap',[['addSmallModule',['$event']]]]]}}" class="btngreen btnform" bindtap="__e">保存</button><button data-event-opts="{{[['tap',[['DelSmallModule',['$event']]]]]}}" class="btnblue btnform" bindtap="__e">删除</button></view></form></view>