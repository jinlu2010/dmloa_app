<view class="newtask"><form data-event-opts="{{[['submit',[['formSubmit',['$event']]]],['reset',[['formReset',['$event']]]]]}}" bindsubmit="__e" bindreset="__e"><view class="form"><view class="form-item"><view class="title">项目标题</view><text>{{name}}</text></view><view class="form-item"><view class="title">负责人</view><text>{{user}}</text></view><view class="form-item"><view class="title">服务对象</view><text>{{client}}</text></view><view class="form-item"><view class="title">服务目的</view><text>{{purpose}}</text></view><view class="form-item"><view class="title">服务目标</view><text>{{goal}}</text></view><view class="form-item"><view class="title">项目周期</view><text>{{start_at+"至"+end_at}}</text></view><view class="form-item"><view class="title">项目状态</view><text>{{status}}</text></view><view class="form-item"><view class="title">对接人</view><text>{{contact}}</text></view><view class="form-item"><view class="title">项目预算</view><text>{{budget}}</text></view><view class="form-item"><view class="title">验收标准</view><text>{{standard}}</text></view><view class="form-item"><view class="title">相关介绍</view><view class="textarea">{{intro}}</view></view></view></form></view>