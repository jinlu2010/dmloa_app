<view><view class="status-contents"><view class="status top-view"><view class="titles"><view class="UserFace"><image src="{{imgUrl}}"></image></view><view class="titleText">{{titleText}}</view></view></view></view><view class="place"></view><view class="bgcalendar"></view><calendar bind:setDate="__e" vue-id="2d56bf2f-1" data-event-opts="{{[['^setDate',[['changeDate']]]]}}" bind:__l="__l"></calendar><view class="list task"><view class="list-item-container"><block wx:if="{{tasklist==''}}"><view><text class="nonetask">今天没有安排任务哦~</text><text class="nonetask">休息一下吧！</text></view></block><block wx:for="{{$root.l1}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['Detail',['$0'],[[['tasklist','id',item.$orig.id]]]]]]]}}" bindtap="__e"><block wx:for="{{item.l0}}" wx:for-item="items" wx:for-index="__i1__" wx:key="id"><block wx:if="{{items.$orig.operator.id==userid}}"><view class="{{['list-item-content',nowdate>item.$orig.end_at&&items.$orig.finished==false?'bgred':items.$orig.delayed==true?'bgorange':null]}}"><view class="pr60 listheight"><view class="list-content-left"><text class="{{['title',nowdate>item.$orig.end_at&&items.$orig.finished==false?'red':null]}}">{{item.$orig.name}}</text><block wx:if="{{items.$orig.delayed==true}}"><text class="note">{{"From "+item.$orig.creator.name+" 延期完成"}}</text></block><block wx:if="{{items.$orig.delayed==false&&items.$orig.finished==true}}"><text class="note">{{"From "+item.$orig.creator.name+" 正常完成"}}</text></block><block wx:if="{{nowdate<item.$orig.end_at&&items.$orig.finished==false}}"><text class="note">{{"From "+item.$orig.creator.name+" 截止"+items.g0}}</text></block><block wx:if="{{nowdate==item.$orig.end_at&&items.$orig.finished==false}}"><text class="note">{{"From "+item.$orig.creator.name+" 截止今日"}}</text></block><block wx:if="{{nowdate>item.$orig.end_at&&items.$orig.finished==false}}"><text class="note">{{"From "+item.$orig.creator.name+" 逾期"+items.m0}}</text></block></view><view class="list-content-right"><button data-event-opts="{{[['tap',[['tapshow',['$0'],[[['tasklist','id',item.$orig.id],['task_items','id',items.$orig.id]]]]]]]}}" hidden="{{!(items.$orig.finished==false&&items.$orig.stopped==false?true:false)}}" class="btngreen" catchtap="__e">进行中</button><image hidden="{{!(items.$orig.finished==false&&items.$orig.stopped==false?false:true)}}" src="{{items.$orig.stopped==true?'../../../static/image/icon06.png':items.$orig.finished==true?'../../../static/image/icon05.png':''}}"></image></view></view></view></block></block></view></block></view></view><view hidden="{{!(show)}}" class="mask"></view><view hidden="{{!(show)}}" class="popup"><view class="popup-content"><form enctype="multipart/form-data" data-event-opts="{{[['submit',[['formSubmit',['$event']]]],['reset',[['formReset',['$event']]]]]}}" bindsubmit="__e" bindreset="__e"><view class="form pl40"><view class="form-item"><view class="title">完成状态</view><picker value="{{status_id}}" range="{{status}}" range-key="name" data-event-opts="{{[['change',[['statusChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{status[status_id].name+''}}<uni-icons class="pl20" vue-id="2d56bf2f-2" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view hidden="{{!(finish)}}" class="form-item"><view class="title">任务耗时</view><picker value="{{time_id}}" range="{{time}}" range-key="name" data-event-opts="{{[['change',[['timeChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{time[time_id].name+'分钟'}}<uni-icons class="pl20" vue-id="2d56bf2f-3" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view hidden="{{!(finish)}}" class="form-item"><view class="title">上传文件</view><uni-file-picker class="vue-ref" vue-id="2d56bf2f-4" limit="2" file-mediatype="all" auto-upload="{{false}}" data-ref="files" data-event-opts="{{[['^select',[['upload']]],['^delete',[['delFile']]]]}}" bind:select="__e" bind:delete="__e" bind:__l="_