<view class="newtask"><form><view class="form"><view class="form-item"><view class="title">部门名称</view><input class="input" placeholder="请输入部门名称" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" value="{{name}}" bindinput="__e"/></view><view class="form-item"><view class="title">部门意义</view><view class="textarea"><textarea auto-height="{{true}}" placeholder="请输入部门意义" data-event-opts="{{[['input',[['__set_model',['','significance','$event',[]]]]]]}}" value="{{significance}}" bindinput="__e"></textarea></view></view><view class="form-item"><view class="title">部门目标</view><view class="textarea"><textarea auto-height="{{true}}" placeholder="请输入部门目标" data-event-opts="{{[['input',[['__set_model',['','goal','$event',[]]]]]]}}" value="{{goal}}" bindinput="__e"></textarea></view></view><view class="form-item"><view class="title">部门职能</view><view class="textarea"><textarea auto-height="{{true}}" placeholder="请输入部门职能" data-event-opts="{{[['input',[['__set_model',['','duty','$event',[]]]]]]}}" value="{{duty}}" bindinput="__e"></textarea></view></view></view><button data-event-opts="{{[['tap',[['addDept']]]]}}" class="btngreen btnform" bindtap="__e">保存</button></form></view>