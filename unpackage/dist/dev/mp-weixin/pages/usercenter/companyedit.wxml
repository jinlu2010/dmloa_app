<view class="newtask"><view class="form"><view class="form-item"><view class="title">企业头像</view><image class="logo" src="{{iconUrl}}"></image></view><view class="form-item"><view class="title">企业名称</view><input data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" class="input" value="{{name}}" bindinput="__e"/></view><view class="form-item"><view class="title">战略目标</view><input data-event-opts="{{[['input',[['__set_model',['','goal','$event',[]]]]]]}}" class="input" value="{{goal}}" bindinput="__e"/></view><view class="form-item"><view class="title">人员规模</view><picker value="{{scale_id}}" range="{{scaleArr}}" range-key="name" data-event-opts="{{[['change',[['scaleArrChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{scaleArr[scale_id].name+''}}<uni-icons class="pl20" vue-id="e36409d6-1" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">联系方式</view><input data-event-opts="{{[['input',[['__set_model',['','phone','$event',[]]]]]]}}" class="input" value="{{phone}}" bindinput="__e"/></view><view class="form-item"><view class="title">企业地址</view><input data-event-opts="{{[['input',[['__set_model',['','address','$event',[]]]]]]}}" class="input" value="{{address}}" bindinput="__e"/></view><view class="form-item"><view class="title">联系邮箱</view><input data-event-opts="{{[['input',[['__set_model',['','email','$event',[]]]]]]}}" class="input" value="{{email}}" bindinput="__e"/></view></view><button data-event-opts="{{[['tap',[['save']]]]}}" class="btngreen btnform" bindtap="__e">保存</button></view>