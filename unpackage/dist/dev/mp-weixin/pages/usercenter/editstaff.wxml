<view class="newtask"><form><view class="form"><view class="form-item"><view class="title">身份</view><radio-group data-event-opts="{{[['change',[['adminChange',['$event']]]]]}}" bindchange="__e"><view class="btnradio"><radio id="普通员工" value="0" checked="{{adminType==0}}">普通员工</radio><radio id="管理员" value="1" checked="{{adminType==1}}">管理员</radio></view></radio-group></view><view class="form-item"><view class="title">姓名</view><input class="input" placeholder="请输入姓名" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" value="{{name}}" bindinput="__e"/></view><view class="form-item"><view class="title">性别</view><radio-group data-event-opts="{{[['change',[['genderChange',['$event']]]]]}}" bindchange="__e"><view class="btnradio"><radio id="男" value="0" checked="{{gender_id==0}}">男</radio><radio id="女" value="1" checked="{{gender_id==1}}">女</radio></view></radio-group></view><view class="form-item"><view class="title">生日</view><picker mode="date" value="{{birthday}}" start="{{startDate}}" end="{{endDate}}" data-event-opts="{{[['change',[['birthdayChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{birthday+''}}<uni-icons class="pl20" vue-id="8f4ebe34-1" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">手机</view><input class="input" placeholder="请输入手机号码" data-event-opts="{{[['input',[['__set_model',['','phone','$event',[]]]]]]}}" value="{{phone}}" bindinput="__e"/></view><view class="form-item"><view class="title">邮箱</view><input class="input" placeholder="请输入邮箱" data-event-opts="{{[['input',[['__set_model',['','email','$event',[]]]]]]}}" value="{{email}}" bindinput="__e"/></view><view class="form-item"><view class="title">部门岗位</view><picker value="{{dept_id}}" range="{{deptArr}}" range-key="name" data-event-opts="{{[['change',[['deptChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{deptArr[dept_id].name+''}}<uni-icons class="pl20" vue-id="8f4ebe34-2" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker><picker value="{{post_id}}" range="{{postArr}}" range-key="name" data-event-opts="{{[['change',[['postChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{postArr[post_id].name+''}}<uni-icons class="pl20" vue-id="8f4ebe34-3" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">负责人</view><radio-group data-event-opts="{{[['change',[['managerChange',['$event']]]]]}}" bindchange="__e"><view class="btnradio"><radio id="是" value="true" checked="{{is_manager==true}}">是</radio><radio id="否" value="false" checked="{{is_manager==false}}">否</radio></view></radio-group></view><view class="form-item"><view class="title">汇报对象</view><picker value="{{report_id}}" range="{{reportArr}}" range-key="name" data-event-opts="{{[['change',[['reportChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{reportArr[report_id].name+''}}<uni-icons class="pl20" vue-id="8f4ebe34-4" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">在职状态</view><picker value="{{status_id}}" range="{{statusArr}}" range-key="name" data-event-opts="{{[['change',[['statusChange',['$event']]]]]}}" bindchange="__e"><view class="input">{{statusArr[status_id].name+''}}<uni-icons class="pl20" vue-id="8f4ebe34-5" type="arrowdown" size="12" color="#999" bind:__l="__l"></uni-icons></view></picker></view><view class="form-item"><view class="title">岗位技能</view><view class="textarea"><textarea placeholder="请输入岗位技能" data-event-opts="{{[['input',[['__set_model',['','skillin','$event',[]]]]]]}}" value="{{skillin}}" bindinput="__e"></textarea></view></view><view class="form-item"><view class="title">岗外技能</view><view class="textarea"><textarea placeholder="请输入岗外技能" data-event-opts="{{[['input',[['__set_model',['','skillout','$event',[]]]]]]}}" value="{{skillout}}" bindinput="__e"></textarea></view></view></view><view class="btn"><button data-event-opts="{{[['tap',[['addStaff']]]]}}" class="btngreen btnform" bindtap="__e">保存</button></view></form></view>